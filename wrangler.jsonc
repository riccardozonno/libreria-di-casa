{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homelibrary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // L'interfaccia è statica (nessuna CPU); il Worker gestisce solo /api/*.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Log delle invocazioni con il tempo di CPU: serve a controllare il limite di 10 ms.
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homelibrary",
      "database_id": "575c54b5-fd86-45ca-a37f-02643bd30487",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "homelibrary-covers" }],
  // Non segreti. Access vuoto = l'API rifiuta tutto (fail closed).
  // I segreti (chiave Google Books, token Access) si impostano con `wrangler secret put`.
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
