{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homelibrary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // L'interfaccia è statica (nessuna CPU); il Worker gestisce solo /api/*.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Log delle invocazioni con il tempo di CPU: serve a controllare il limite di 10 ms.
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homelibrary",
      "database_id": "575c54b5-fd86-45ca-a37f-02643bd30487",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "homelibrary-covers" }],
  // Limiti di frequenza per persona (worker/rate-limit.ts). namespace_id: numeri scelti da noi, unici nell'account.
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "LOOKUP_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "CSV_LIMITER", "namespace_id": "4103", "simple": { "limit": 600, "period": 60 } }
  ],
  // Non segreti. Access vuoto = l'API rifiuta tutto (fail closed).
  // I segreti (chiave Google Books, token Access) si impostano con `wrangler secret put`.
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "solitary-brook-795e.cloudflareaccess.com",
    "ACCESS_AUD": "3406c75f6351cad7cb4d0c40b3f683e6d3c9f16cb674c853db8463004ba5afce",
    // Gruppo Access "Utenti HOME LIBRARY", riscritto dall'app quando cambiano gli utenti (token: segreto CF_API_TOKEN).
    "CF_ACCOUNT_ID": "326ab8b7c75407dcee433c023a995fb1",
    "ACCESS_GROUP_ID": "b5898622-0cc4-4647-a02b-5cf47215a81e"
  }
}
