{
  // File di configurazione e strumenti di build (Node). Gli altri ambienti hanno il loro tsconfig:
  // src/ (browser), worker/ (Cloudflare Workers), shared/ (neutro), tests/. `pnpm typecheck` li controlla tutti.
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "lib": ["ES2024"], "types": ["node"] },
  "include": ["*.ts", "tools", "scripts"],
  "exclude": ["node_modules", "dist", "spike", "worker-configuration.d.ts"]
}
