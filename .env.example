# HOME LIBRARY — variabili d'ambiente.
# Copia in `.env` (mai in git) e compila. In produzione: chmod 600 .env

# --- Database (PostgreSQL nel compose) ---
# Le password finiscono dentro URL di connessione: usa solo lettere e numeri, es. openssl rand -hex 24
# Proprietario dello schema: usato solo dalle migrazioni.
POSTGRES_DB=homelibrary
POSTGRES_USER=migrator
POSTGRES_PASSWORD=cambia-questa-password-lunga
# Ruolo con soli permessi sui dati, usato dall'app (creato da ops/db/init-roles.sh).
APP_DB_PASSWORD=cambia-anche-questa-password-lunga
# Stringhe di connessione (host "db" dentro Docker).
DATABASE_URL=postgresql://app:cambia-anche-questa-password-lunga@db:5432/homelibrary
MIGRATION_DATABASE_URL=postgresql://migrator:cambia-questa-password-lunga@db:5432/homelibrary

# --- Autenticazione (Better Auth) ---
# Segreto casuale di almeno 32 caratteri: openssl rand -base64 48
BETTER_AUTH_SECRET=
# URL pubblico dell'app: in produzione https://libri.riccardozonno.it
BETTER_AUTH_URL=http://localhost:3000
# true in produzione: gli admin devono attivare la 2FA (TOTP).
REQUIRE_ADMIN_2FA=false
# true in produzione: rifiuta richieste senza header CF-Connecting-IP (arrivano solo da cloudflared).
TRUST_CLOUDFLARE_ONLY=false

# --- Libri ---
# Chiave API Google Books (solo lato server).
GOOGLE_BOOKS_API_KEY=
# Cartella delle copertine dentro il container.
COVERS_DIR=/data/covers

# --- Cloudflare Tunnel (fase 6) ---
TUNNEL_TOKEN=
