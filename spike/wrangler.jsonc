{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homelibrary-spike",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // L'interfaccia è statica (gratis, nessuna CPU); il Worker gestisce solo /api/*.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Log delle invocazioni con il tempo di CPU di ogni richiesta: è la misura principale della fase 1.
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homelibrary-spike",
      "database_id": "c69214fb-1c61-4731-8583-c0756f21e884",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "homelibrary-spike-covers" }],
  // Access: emittente e audience del JWT (non sono segreti). Vuoti = l'API rifiuta tutto (fail closed).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "solitary-brook-795e.cloudflareaccess.com",
    "ACCESS_AUD": "4c6304a3112f23f761625950f750e4f678dcaa495fe27f2959c1a17f3bafb825"
  }
}
