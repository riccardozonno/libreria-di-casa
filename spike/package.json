{
  "name": "homelibrary-spike",
  "private": true,
  "type": "module",
  "description": "Fase 1 (v2): prova di fattibilità su Cloudflare Workers + D1 + R2 + Access. Usa e getta.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed.mjs 5000 > .wrangler/seed.sql && wrangler d1 execute DB --local --file .wrangler/seed.sql",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "barcode-detector": "^3.2.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
