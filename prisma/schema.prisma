// Modello dati di HOME LIBRARY: vedi docs/data-model.md e ADR-0006.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // L'estensione pg_trgm è creata a mano nella prima migrazione (indice trigram su Book.searchText).
}

enum Role {
  ADMIN
  EDITOR
  READER
}

enum BookSource {
  GOOGLE_BOOKS
  OPEN_LIBRARY
  MANUAL
  CSV
}

// --- Better Auth (user / session / account / verification / twoFactor) ---

model User {
  id               String    @id @db.Uuid
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  role             Role      @default(READER)
  active           Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  twoFactors     TwoFactor[]
  editorOf       LocationEditor[]
  readings       BookReading[]    @relation("ReadingUser")
  readingsMarked BookReading[]    @relation("ReadingMarkedBy")
  booksCreated   Book[]
  copiesCreated  Copy[]
  movements      CopyMovement[]
  auditEntries   AuditLog[]
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id          String @id @db.Uuid
  secret      String
  backupCodes String
  userId      String @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Dominio ---

model Location {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  nameKey    String    @unique
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  copies        Copy[]
  editors       LocationEditor[]
  movementsFrom CopyMovement[]   @relation("MovementFrom")
  movementsTo   CopyMovement[]   @relation("MovementTo")
}

model LocationEditor {
  userId     String   @db.Uuid
  locationId String   @db.Uuid
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
}

model Book {
  id            String     @id @default(uuid(7)) @db.Uuid
  isbn13        String?    @unique
  title         String
  authors       String[]
  publishedYear Int?
  description   String?
  coverPath     String?
  source        BookSource
  searchText    String
  createdById   String?    @db.Uuid
  createdBy     User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  copies    Copy[]
  readings  BookReading[]
  movements CopyMovement[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([title])
}

model Copy {
  id          String   @id @default(uuid(7)) @db.Uuid
  bookId      String   @db.Uuid
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  locationId  String   @db.Uuid
  location    Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  shelf       String?
  notes       String?
  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements CopyMovement[]

  @@index([locationId])
  @@index([bookId])
}

model CopyMovement {
  id             String   @id @default(uuid(7)) @db.Uuid
  bookId         String   @db.Uuid
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  copyId         String?  @db.Uuid
  copy           Copy?    @relation(fields: [copyId], references: [id], onDelete: SetNull)
  fromLocationId String   @db.Uuid
  fromLocation   Location @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String   @db.Uuid
  toLocation     Location @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  movedById      String?  @db.Uuid
  movedBy        User?    @relation(fields: [movedById], references: [id], onDelete: SetNull)
  movedAt        DateTime @default(now())

  @@index([bookId, movedAt])
}

model BookReading {
  userId     String   @db.Uuid
  user       User     @relation("ReadingUser", fields: [userId], references: [id], onDelete: Cascade)
  bookId     String   @db.Uuid
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  markedById String   @db.Uuid
  markedBy   User     @relation("ReadingMarkedBy", fields: [markedById], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, bookId])
  @@index([bookId])
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  data       Json
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
